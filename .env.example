# ===========================================
# MavunoIQ Backend API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# Only required variables need to be set for basic operation.
# Optional provider credentials enable live integrations.

# ----- Core -----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ----- Database -----
# Required. MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/mavunoiq

# ----- Authentication -----
# Required. Use long random strings (>= 32 chars).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ----- AI Provider (Optional) -----
# AI_PROVIDER can be: openai | demo | (blank = disabled)
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000

# ----- Weather Provider (Optional) -----
# WEATHER_PROVIDER can be: openweathermap | demo | (blank = disabled)
WEATHER_PROVIDER=demo
WEATHER_API_KEY=
WEATHER_TIMEOUT_MS=10000
WEATHER_CACHE_TTL_SECONDS=1800

# ----- Market Data Provider (Optional) -----
# MARKET_DATA_PROVIDER can be: manual | demo | (blank = disabled)
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=

# ----- Payments (Optional) -----
# PAYMENT_PROVIDER can be: mpesa | demo | (blank = disabled)
PAYMENT_PROVIDER=demo
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:5000/api/v1/payments/mpesa/callback

# ----- Email Provider (Optional) -----
# EMAIL_PROVIDER can be: resend | smtp | demo | (blank = disabled)
EMAIL_PROVIDER=demo
EMAIL_API_KEY=
EMAIL_FROM=noreply@mavunoiq.local

# ----- Storage Provider (Optional) -----
# STORAGE_PROVIDER can be: s3 | local | demo | (blank = disabled)
STORAGE_PROVIDER=local
STORAGE_BUCKET=mavunoiq-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_LOCAL_DIR=./uploads

# ----- Cache (Optional) -----
REDIS_URL=

# ----- Observability (Optional) -----
SENTRY_DSN=
LOG_LEVEL=info

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ----- Bootstrap Admin (Optional) -----
# Used only by the provision-admin script.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=